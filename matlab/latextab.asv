function latextab(table)
    fpw = fopen("latextab.txt", "w");

    %numero de colunas
    ncol = size(table.Properties.VariableNames);
    nrow = height(table);

    %cabeçalho do tabular
    fprintf(fpw, "\\begin{table}[H] \n \t\centering \n\n \t\begin{tabular}{");

    for i = 1:ncol
        fprintf(fpw, "c");

        if (i == ncol)
            fprintf(fpw, "}\n");
        else
            fprintf(fpw, " ");
        end
    end

    %cabeçalho da tabela
    fprintf(fpw, "\t\t");
    for i = 1:ncol
        fprintf(fpw, "%s ", table.Properties.VariableNames(i));

        if (i == ncol)
            fprintf("\\\\ \n");
        else
            fprintf("& ");
        end
    end

    %corpo da tabela
    for i = 1:nrow
        fprintf(fpw, "\t\t");
        for j = 1:ncol
            fprintf(fpw, "%s", string(table{i, j}));
            
            if (j == ncol)
                fprintf(fpw, "\\\\ \n");
            else
                fprintf(fpw, " & ");
            end
        end
    end



    fclose(fpw);
end